{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready_for_hil", "pass", "human_review"]
    },
    "summary": {
      "type": "string"
    },
    "hil_script": {
      "type": "string"
    },
    "expected_display": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["match", "mismatch", "unreviewable"]
          },
          "observed_rows": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layout_matches": {
            "type": "boolean"
          },
          "forbidden_observed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observed": {
            "type": "string"
          }
        },
        "required": [
          "image",
          "status",
          "observed_rows",
          "layout_matches",
          "forbidden_observed",
          "observed"
        ]
      }
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_review_reason": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "summary",
    "hil_script",
    "expected_display",
    "visual_validation",
    "tests_run",
    "remaining_issues",
    "human_review_reason"
  ]
}
